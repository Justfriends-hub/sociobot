# 1. Required — your token from @BotFather (format: 123456789:AAH...)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# 2. Only for free web hosts (Render / Koyeb), not for your PC.
#    Paste your app's public URL and the bot switches to webhook mode.
#    Leave it commented out to run normally (polling).
# WEBHOOK_URL=https://your-app.onrender.com

# 3. Optional. Extra password Telegram sends with each message.
# WEBHOOK_SECRET=some-random-text
